{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/prediction/auth/:path*", "destination": "https://predictsim-prediction-service.onrender.com/auth/:path*" },
    { "source": "/api/prediction/users/:id", "destination": "https://predictsim-prediction-service.onrender.com/users/:id" },
    { "source": "/api/prediction/rates/meta", "destination": "https://predictsim-prediction-service.onrender.com/rates/meta" },
    { "source": "/api/prediction/rates/me", "destination": "https://predictsim-prediction-service.onrender.com/rates/me" },
    { "source": "/api/prediction/ledger", "destination": "https://predictsim-prediction-service.onrender.com/ledger" },
    { "source": "/api/prediction/predictions/me", "destination": "https://predictsim-prediction-service.onrender.com/predictions/me" },
    { "source": "/api/prediction/token-requests", "destination": "https://predictsim-prediction-service.onrender.com/token-requests" },
    { "source": "/api/prediction/token-requests/me", "destination": "https://predictsim-prediction-service.onrender.com/token-requests/me" },
    { "source": "/api/prediction/token-requests/:id/cancel", "destination": "https://predictsim-prediction-service.onrender.com/token-requests/:id/cancel" },
    { "source": "/api/prediction/token-requests/:id/image", "destination": "https://predictsim-prediction-service.onrender.com/token-requests/:id/image" },
    { "source": "/api/prediction/games/active", "destination": "https://predictsim-prediction-service.onrender.com/games/active" },
    { "source": "/api/prediction/games/:id/history", "destination": "https://predictsim-prediction-service.onrender.com/games/:id/history" },
    { "source": "/api/prediction/predictions", "destination": "https://predictsim-prediction-service.onrender.com/predictions" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
